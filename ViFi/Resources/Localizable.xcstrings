{
  "sourceLanguage" : "tr",
  "strings" : {
    "%@ - Dosya %lld" : {
      "comment" : "File name of a shared PDF when an exam has several, e.g. “2018 VİZE - Dosya 2”. Avoid / \\ : characters.",
