        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ - File %2$lld"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ - Dosya %2$lld"
          }
        }
      }
    },
